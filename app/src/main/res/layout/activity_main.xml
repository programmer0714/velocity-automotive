<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- AVATAR -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_gold"
            android:gravity="center"
            android:textColor="@color/bg_dark"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:text="U"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- LOGO -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:src="@drawable/logo_velocity"
            android:scaleType="fitCenter"/>

    </LinearLayout>

    <!-- SEARCH -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_input"
        android:hint="Buscar marca, modelo..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:imeOptions="actionSearch"/>

    <!-- CHIPS MARCAS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Todos"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_button_gold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipFerrari"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ferrari"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipLamborghini"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Lamborghini"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipPorsche"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Porsche"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipMcLaren"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="McLaren"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipBugatti"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Bugatti"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipAstonMartin"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Aston Martin"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:background="@drawable/bg_chip"
                android:layout_marginEnd="8dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- PROGRESS -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/> <!--spiner oculto por defecto-->

    <!-- ERROR -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FF6B6B"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reintentar"
        android:textColor="@color/gold_primary"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:padding="8dp"
        android:visibility="gone"/>

    <!-- LISTA CARROS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"/>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:elevation="12dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgNavHome"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/home"
                app:tint="@color/gold_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/gold_primary"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- CATEGORÍAS -->
        <LinearLayout
            android:id="@+id/btnNavCategory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgNavCategory"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/categories"
                app:tint="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorías"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- CALENDARIO -->
        <LinearLayout
            android:id="@+id/btnNavCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgNavCalendar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/calendar"
                app:tint="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Citas"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- FAVORITOS -->
        <LinearLayout
            android:id="@+id/btnNavFav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgNavFav"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/favorite"
                app:tint="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoritos"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgNavProfile"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/user"
                app:tint="@color/text_secondary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perfil"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
