<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0">

        <!-- Logo imagen en lugar del texto V / VELOCITY / AUTOMOTIVE -->
        <ImageView
            android:layout_width="300dp"
            android:layout_height="240dp"
            android:src="@drawable/logo_velocity"
            android:scaleType="fitCenter"
            android:layout_gravity="center"/>

        <!-- Línea dorada decorativa -->
        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:background="@color/gold_primary"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>

        <!-- Tagline debajo del logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LA COLECCIÓN DEFINITIVA"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:letterSpacing="0.2"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_gravity="center"/>

    </LinearLayout>

    <!-- Texto inferior -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:text="RENDIMIENTO • EXCELENCIA • LUJO"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.3"
        android:alpha="0"/>

</RelativeLayout>